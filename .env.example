# Copy to .env for reference only — the app reads real environment variables
# (set them in the Render dashboard; see docs/OPERATIONS.md). Nothing here is
# needed to install or run the tests.

# Required
DATABASE_URL=postgres://user:pass@host/db   # Neon; "localhost" in the URL turns SSL off
ADMIN_PASSWORD=                             # admin login; login is refused without it
JWT_SECRET=                                 # signs admin tokens (Render generates it)

# Optional — each feature is a silent no-op until its variables are set
VAPID_PUBLIC_KEY=                           # Web Push to the admin
VAPID_PRIVATE_KEY=
INFOBIP_BASE_URL=                           # SMS, e.g. xxxxx.api.infobip.com (needs all three)
INFOBIP_API_KEY=
INFOBIP_SENDER=
GMAIL_USER=                                 # email (needs both)
GMAIL_APP_PASSWORD=
EMAIL_FROM=                                 # default: R-EDA'S STUDIO <GMAIL_USER>
GOOGLE_SA_EMAIL=                            # Google Calendar (needs all three)
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
APPOINTMENT_MINUTES=60                      # calendar event length
PORT=3000                                   # Render sets this
